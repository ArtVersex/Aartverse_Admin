# Copy this file to .env and fill in real values.
# Never commit .env — it is already listed in .gitignore.

# Same MariaDB/MySQL database AartVerse_v1 (the public site) reads from.
# The DB user here must have INSERT/UPDATE/DELETE privileges.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Hostinger SFTP — where artwork/artist images are uploaded to.
SFTP_HOST=
SFTP_PORT=65002
SFTP_USERNAME=
SFTP_PASSWORD=

# Remote folders + matching public URLs images are served from. Defaults
# below match the existing site convention (lib/config.py falls back to
# these same values if left blank here).
REMOTE_ARTWORK_IMAGE_FOLDER=domains/springgreen-antelope-607895.hostingersite.com/public_html/images/artworks
PUBLIC_ARTWORK_IMAGE_BASE_URL=https://springgreen-antelope-607895.hostingersite.com/images/artworks
REMOTE_ARTIST_IMAGE_FOLDER=domains/springgreen-antelope-607895.hostingersite.com/public_html/images/artists
PUBLIC_ARTIST_IMAGE_BASE_URL=https://springgreen-antelope-607895.hostingersite.com/images/artists

# The password you'll be asked for when opening the app. Anyone who knows
# this can add, edit, or delete site data.
ADMIN_PASSWORD=
